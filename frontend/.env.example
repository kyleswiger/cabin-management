# Values come from `terraform output` in infra/
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Playwright end-to-end tests (frontend/e2e) ---
# The deployment to test against. Defaults to https://jacksplaceattheridge.com if unset.
E2E_BASE_URL=https://your-site.example.com
# The dedicated test account from backend/scripts/create-test-user.mjs.
E2E_EMAIL=playwright-e2e@your-domain.example.com
E2E_PASSWORD=the-permanent-password-you-set
# The API URL / pool / client default to the VITE_* values above; override only if the
# site under test is a different deployment than this build config points at.
# E2E_API_URL=
# E2E_USER_POOL_ID=
# E2E_CLIENT_ID=
